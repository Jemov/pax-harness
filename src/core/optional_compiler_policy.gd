extends RefCounted
## Only the autogenerated legacy default can fall back; custom profiles fail closed.
static func legacy_default_limit(profile: String, error: String, enabled_count: int) -> bool:
	if profile != "local_assistant" or enabled_count <= 64: return false
	if not error.begins_with("laboratory_compile_failed:"): return false
	var fields: PackedStringArray = error.trim_prefix("laboratory_compile_failed:").split(",")
	return not fields.is_empty() and Array(fields).all(func(field: String): return field.strip_edges() == "enabled_tools")
